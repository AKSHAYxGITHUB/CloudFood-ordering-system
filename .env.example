# Copy to .env for local development. On Vercel, set these as Project Environment Variables instead.

# Postgres connection string (Neon / Vercel Postgres). Use the pooled connection string in serverless.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Flask
SECRET_KEY=change-me-to-a-long-random-value
FLASK_ENV=production

# JWT (simulates the report's AWS Secrets Manager-stored signing key)
JWT_SECRET_KEY=change-me-to-a-different-long-random-value

# Seed admin account (created by `flask --app wsgi init-db`)
ADMIN_EMAIL=admin@foodies.com
ADMIN_PASSWORD=ChangeMe123!
